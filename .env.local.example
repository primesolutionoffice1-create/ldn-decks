# Site
NEXT_PUBLIC_SITE_URL=https://ldndecks.com

# Google / Gemini server-only
# Never prefix Gemini or Google Cloud server keys with NEXT_PUBLIC_.
GEMINI_API_KEY=replace-with-server-only-gemini-key
GOOGLE_CLOUD_PROJECT_ID=replace-with-google-cloud-project-id

# Google Maps public browser key only if required
# This key may be public, but must be restricted by HTTP referrer and exact APIs in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-restricted-browser-key

# DataForSEO server-only
DATAFORSEO_LOGIN=replace-with-dataforseo-login
DATAFORSEO_PASSWORD=replace-with-dataforseo-password

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-random-admin-password

# Optional analytics / SEO
NEXT_PUBLIC_GA_MEASUREMENT_ID=replace-with-public-ga4-id
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://ldndecks.com/
GOOGLE_CRUX_API_KEY=replace-with-server-only-crux-key
AHREFS_API_TOKEN=replace-with-server-only-ahrefs-token

# Email / lead delivery server-only
EMAIL_USER=replace-with-email-user
EMAIL_PASS=replace-with-email-app-password
EMAIL_TO=replace-with-recipient-email
GHL_INBOUND_WEBHOOK_URL=replace-with-ghl-webhook-url
GHL_API_KEY=replace-with-ghl-api-key
GHL_LOCATION_ID=replace-with-ghl-location-id
GHL_OWNER_USER_ID=replace-with-ghl-user-id
GHL_SITE_VISIT_CALENDAR_ID=replace-with-calendar-id

# Voice AI / SMS server-only
VAPI_WEBHOOK_SECRET=replace-with-vapi-webhook-secret
OWNER_CELL=replace-with-owner-phone
TWILIO_SID=replace-with-twilio-sid
TWILIO_TOKEN=replace-with-twilio-token
TWILIO_FROM=replace-with-twilio-from-number

# Meta CAPI server-only
META_PIXEL_ID=replace-with-meta-pixel-id
META_CAPI_ACCESS_TOKEN=replace-with-meta-capi-token
META_CAPI_TEST_EVENT_CODE=
